<Project>
  <!-- Shared settings for both projects. Set GameDir to your Crawl install (the folder with Crawl.exe and, after
       installing BepInEx, the BepInEx folder), here or on the command line: dotnet build -p:GameDir="D:\Games\Crawl" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Crawl</GameDir>
    <ManagedDir>$(GameDir)\Crawl_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>

    <!-- Unity 5.4's Mono: compile against the game's own mscorlib / System / System.Core, C# 7.3 -->
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- both DLLs land in build/, like build.sh -->
    <OutputPath>$(MSBuildThisFileDirectory)build\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- lets MSBuild resolve net35 without the .NET 3.5 targeting pack installed (compile-time only) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(ManagedDir)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(ManagedDir)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(ManagedDir)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ex2D.Runtime"><HintPath>$(ManagedDir)\ex2D.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
